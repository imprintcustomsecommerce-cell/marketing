APP_NAME="Imprint Hub"
APP_ENV=local
APP_KEY=
APP_TIMEZONE=Asia/Manila
APP_DEBUG=true
APP_URL=http://localhost

# Public client surface. Set the stable Cloudflare hostname without a trailing slash.
# Leave PUBLIC_CLIENT_HOST empty for local Quick Tunnel development.
PUBLIC_CLIENT_URL=
PUBLIC_CLIENT_HOST=
INTERNAL_HOSTS=localhost,127.0.0.1,imprint-hub

# Initial LAN administrator. Change the password after initial deployment.
ADMIN_NAME="Joey"
ADMIN_EMAIL=admin@imprintcustoms.ph
ADMIN_PASSWORD="change-me-on-first-run"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Local/NAS backups. The NAS path is optional and is never required at runtime.
LOCAL_BACKUP_PATH=
NAS_BACKUP_PATH=

# Enable only after a stable public hostname is configured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

# Set to false only while testing, to skip the forced password change.
REQUIRE_PASSWORD_CHANGE=true
